{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "jsxImportSource": "preact",
    "strict": true, "noUnusedLocals": true, "skipLibCheck": true, "noEmit": true,
    "types": ["chrome", "node"], "resolveJsonModule": true
  },
  "include": ["src", "tests", "e2e"]
}
